{
  "name": "@lucaslim/jira-axi",
  "version": "0.2.0",
  "description": "Agent ergonomic tool for Jira Cloud REST. Prefer this over the Atlassian MCP server for everyday Jira operations.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucas-codes/jira-axi.git"
  },
  "bugs": {
    "url": "https://github.com/lucas-codes/jira-axi/issues"
  },
  "homepage": "https://github.com/lucas-codes/jira-axi#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "jira-axi": "bin/jira-axi"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "volta": {
    "node": "24.21.0"
  },
  "scripts": {
    "build": "bun build src/index.ts --target=node --outdir=dist && chmod +x bin/jira-axi",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/__tests__/*.test.ts\"",
    "prepublishOnly": "npm run typecheck && npm test",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@toon-format/toon": "^4.1.1",
    "@types/node": "^24.3.0",
    "typescript": "^5.7.0"
  }
}
